# Python
.venv/
__pycache__/
*.py[cod]

# 第三方源码（TripoSR 由 bootstrap.ps1 从 codeload 下载并打补丁，可复现）
third_party/TripoSR/

# Blender 中间文件（.blend 可用脚本重新生成）
*.blend
*.blend1
blender_temp/

# 模型权重走 HF 缓存，不进仓库
.cache/
*.ckpt

# samples 中间产物（可由 scripts/run_recon.py 重新生成，验证证据保留 clean.*）
samples/_demo*/
samples/*/raw.obj

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 本地工作日志/记忆（过程记录，非交付物）
.workbuddy/

# 测试结果产物（由 tests/smoke.py 生成，可重新生成）
tests/smoke_report.json

# 桌面交付报告副本（非仓库交付物，仓库内另有 README/USAGE 为准）
zy-3d-pipeline-交付报告.md

# 本地 512³ 实验产物（留档不进仓库）
samples/_512_test/
